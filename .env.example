# Browser-safe Supabase settings for the Vite app.
# Values prefixed with VITE_ are exposed to browser code.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-public-publishable-or-anon-key

# Trusted importer settings. Never expose this key in browser code.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only credential for real room image editing.
# Leave unset to run the POC request pipeline in clearly labeled mock mode.
OPENAI_API_KEY=your-openai-api-key
